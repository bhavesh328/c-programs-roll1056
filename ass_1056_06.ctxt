
#include <stdio.h>

int main() 
{
    int number, sum = 0, temp;

    printf("Enter a number: ");
    scanf("%d", &number);

    temp = number;  

    while (temp != 0)
{
        sum += temp % 10;  
        temp = temp / 10; 
    }

    printf("Sum of digits of %d is %d\n", number, sum);

    return 0;
}


